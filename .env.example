# ──────────────────────────────────────────────
# Дента-Плюс RAG Agent — шаблон переменных окружения
# Скопируйте этот файл в .env и заполните значения
# ──────────────────────────────────────────────

# Telegram Bot (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# LLM-провайдер (OpenAI-совместимый endpoint)
# Ollama (локально):   http://localhost:11434/v1  |  api_key = ollama
# OpenRouter:          https://openrouter.ai/api/v1
# OpenAI:              https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Хранилище
CHROMA_PERSIST_DIR=./storage/chroma
SQLITE_DB_PATH=./storage/leads.db

# RAG-поиск
TOP_K_RESULTS=3

# Параметры агента
HISTORY_LIMIT=10
MAX_TOOL_TURNS=3

# Администраторы (comma-separated Telegram user IDs, пусто — команда /leads недоступна)
# Пример: ADMIN_USER_IDS=[123456789,987654321]
ADMIN_USER_IDS=[]

# amoCRM API v4 Integration
AMO_CRM_ENABLED=false
AMO_CRM_SUBDOMAIN=your_subdomain
AMO_CRM_ACCESS_TOKEN=your_long_lived_access_token
AMO_CRM_FIELD_VISIT_TIME_ID=0
AMO_CRM_FIELD_SERVICE_ID=0
AMO_CRM_STATUS_CONFIRMED_ID=0
